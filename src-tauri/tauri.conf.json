{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoVault",
  "version": "0.1.0",
  "identifier": "com.talix.photovault",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PhotoVault",
        "width": 1100,
        "height": 760,
        "minWidth": 600,
        "minHeight": 400,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
